# Copier ce fichier en .env puis adapter.

# URL publique du site (liens dans les emails, retours Stripe, sitemap, balises canonical)
# En production : https://annuaire.example.com
SITE_URL=http://localhost:4321

# Base SQLite et fichiers envoyés (logos, photos)
DATABASE_PATH=./data/annuaire.db
UPLOADS_DIR=./data/uploads

# Compte administrateur créé par `npm run db:seed`
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-moi
# Mot de passe des comptes de démonstration (vide = ADMIN_PASSWORD)
DEMO_PASSWORD=

# Paiement Stripe (laisser vide = mode démo : paiement simulé, rien n'est débité)
# Seule STRIPE_SECRET_KEY est à copier depuis Stripe : `npm run stripe:setup` crée les produits, prix, webhook
# et portail client, puis remplit les lignes suivantes.
STRIPE_SECRET_KEY=
# Un prix récurrent TTC par formule et périodicité (Pro 9 € HT/mois · 99 € HT/an, Premium 19 € HT/mois · 190 € HT/an)
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PREMIUM_MONTH=
STRIPE_PRICE_PREMIUM_YEAR=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG=

# Facturation Axonaut (plateforme agréée) : Axonaut > clé à molette > API.
# Vide = les paiements Stripe sont enregistrés et les factures restent « en attente » jusqu'à ce que la clé soit renseignée.
AXONAUT_API_KEY=

# Avis Google via DataForSEO (identifiants API : app.dataforseo.com > API Access). Vide = pas de récupération.
# DATAFORSEO_API_URL=https://sandbox.dataforseo.com pour tester sans frais (données fictives).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Emails via Resend (laisser vide = les emails sont seulement visibles dans Admin > Emails)
RESEND_API_KEY=
MAIL_FROM=Annuaire Votre ville <contact@example.com>
