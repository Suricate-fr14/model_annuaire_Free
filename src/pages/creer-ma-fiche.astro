---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import { SITE, CITY } from '../config';
import { listFiches } from '../lib/fiches';
import { categoryName } from '../lib/taxonomy';
import { readIntent, withIntent, intentLabel } from '../lib/intent';
import { PLANS, planLabel } from '../config';

// Étape 1 : vérifier si l'établissement existe déjà (pour éviter les doublons et proposer la revendication).
const q = (Astro.url.searchParams.get('nom') ?? '').trim().slice(0, 100);
const city = (Astro.url.searchParams.get('ville') ?? '').trim().slice(0, 80);
const results = q.length >= 2 ? listFiches({ q: `${q} ${city}`.trim(), limit: 8 }).items : [];
const intent = readIntent(Astro.url);
const createHref = withIntent(`/compte/fiches/nouvelle?nom=${encodeURIComponent(q)}&ville=${encodeURIComponent(city)}`, intent);
const user = Astro.locals.user;
const nextCreate = user ? createHref : `/inscription?next=${encodeURIComponent(createHref)}`;
---
<Base title={`Créer ou revendiquer ma fiche | ${SITE.fullName}`} description={`Référencez gratuitement votre entreprise ou votre commerce dans l'annuaire ${CITY.of} : horaires, coordonnées, réseaux sociaux. Plan d'accès et site internet avec Pro et Premium.`}>
  <div class="wrap narrow">
    <header class="page-head">
      <h1>Référencez votre établissement</h1>
      <p>Gratuit, en 5 minutes. Vérifions d'abord qu'il n'est pas déjà dans l'annuaire.</p>
    </header>

    {intent && (
      <p class="intent">
        <Icon name="star" size={16} /> Formule choisie : <strong>{intentLabel(intent)}</strong> ({planLabel(PLANS[intent.plan], intent.interval)}).
        Créez ou revendiquez d'abord votre fiche : le paiement vous sera proposé dès sa validation. <a href="/tarifs">Changer</a>
      </p>
    )}

    <ol class="steps">
      <li class="on"><span>1</span> Recherche</li>
      <li><span>2</span> Compte</li>
      <li><span>3</span> Fiche</li>
      <li><span>4</span> Validation</li>
      {intent && <li><span>5</span> Paiement</li>}
    </ol>

    <form class="panel form" method="get">
      {intent && <><input type="hidden" name="formule" value={intent.plan} /><input type="hidden" name="periode" value={intent.interval} /></>}
      <div class="row2">
        <label class="field"><span>Nom de votre établissement</span><input name="nom" value={q} required placeholder="Ex. Boulangerie du Château" /></label>
        <label class="field"><span>Ville</span><input name="ville" value={city} placeholder={`Ex. ${CITY.name}`} /></label>
      </div>
      <div><button class="btn gradient-bg" type="submit"><Icon name="search" size={16} /> Vérifier</button></div>
    </form>

    {q.length >= 2 && (
      <section class="res">
        {results.length ? (
          <>
            <h2>Est-ce l'un de ces établissements ?</h2>
            <ul class="list">
              {results.map((f) => (
                <li class="panel item">
                  <Avatar name={f.name} src={f.logo} size={48} />
                  <div class="txt">
                    <strong><a href={`/${f.slug}`} target="_blank">{f.name}</a></strong>
                    <span class="muted">{categoryName(f.category)} · {[f.street, f.city].filter(Boolean).join(', ')}</span>
                  </div>
                  {f.owner_id ? <span class="badge">Déjà gérée</span> : <a class="btn btn-ghost btn-sm" href={withIntent(`/revendiquer/${f.slug}`, intent)}>C'est le mien, revendiquer</a>}
                </li>
              ))}
            </ul>
            <p class="none">Aucun ne correspond ? <a class="btn gradient-bg" href={nextCreate}>Créer une nouvelle fiche</a></p>
          </>
        ) : (
          <div class="panel">
            <h2>Aucune fiche trouvée pour « {q} »</h2>
            <p class="muted">Votre établissement n'est pas encore référencé : créez sa fiche.</p>
            <a class="btn gradient-bg" href={nextCreate}>Créer ma fiche</a>
          </div>
        )}
      </section>
    )}

    <section class="why">
      <div class="panel"><h3>Gratuit</h3><p class="muted">Nom, adresse, horaires, réseaux sociaux, services, logo.</p></div>
      <div class="panel"><h3>Visible</h3><p class="muted">Votre fiche apparaît dans la recherche de l'annuaire, sa catégorie et sa ville.</p></div>
      <div class="panel"><h3>Pro et Premium</h3><p class="muted">Téléphone et email affichés, référencement Google, site internet, plan d'accès, photos et statistiques. Premium : tête de liste, vidéos et demandes de devis. {SITE.pro.priceLabel}. <a href="/tarifs">Voir les tarifs</a></p></div>
    </section>
  </div>
</Base>

<style>
  .narrow { max-width: 68rem; }
  .steps { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1rem; padding: 0; }
  .steps li { display: flex; align-items: center; gap: .45rem; padding: .35rem .8rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: .86rem; font-weight: 600; color: var(--muted); }
  .steps span { display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--surface-2); font-size: .75rem; }
  .steps .on { color: var(--text); border-color: var(--accent); }
  .steps .on span { background: var(--accent); color: #fff; }
  .res { margin-top: 1.5rem; }
  .intent { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: 0 0 1rem; padding: .8rem 1rem; border-radius: 12px; background: color-mix(in srgb, #f59e0b 16%, var(--surface)); border: 1px solid color-mix(in srgb, #f59e0b 40%, var(--line)); font-size: .93rem; }
  .intent a { color: var(--accent); font-weight: 600; }
  .res h2 { font-size: 1.15rem; margin: 0 0 .75rem; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .item { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding: 1rem; }
  .txt { flex: 1; min-width: 12rem; display: flex; flex-direction: column; }
  .txt a:hover { color: var(--accent); }
  .none { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1rem; }
  .why { display: grid; gap: 1rem; margin-top: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .why h3 { margin: 0 0 .3rem; }
  .why p { margin: 0; }
  .why a { color: var(--accent); font-weight: 600; }
</style>
