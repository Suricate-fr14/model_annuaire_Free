---
import { ENV } from '../config';

interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem', position: i + 1, name: it.name,
    ...(it.href && { item: `${ENV.siteUrl}${it.href}` }),
  })),
};
---
<nav aria-label="Fil d'Ariane" class="crumbs">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; font-size: .88rem; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: .35rem; color: var(--accent-2); font-weight: 700; }
  .crumbs a:hover { color: var(--text); text-decoration: underline; }
  [aria-current] { color: var(--text); font-weight: 500; }
</style>
