---
import Avatar from './Avatar.astro';
import Name from './Name.astro';
import OpenBadge from './OpenBadge.astro';
import { SITE } from '../config';
import { categoryName } from '../lib/taxonomy';
import { phoneMasked } from '../lib/text';
import { activeNews, type Fiche } from '../lib/fiches';

interface Props { fiche: Fiche; sponsored?: boolean; sponsorId?: number }
const { fiche: f, sponsored = false, sponsorId } = Astro.props;
// Premium (ou mise en avant sponsorisée) : visuel (bannière, sinon 1re photo), accroche et pastilles.
const rich = f.premium || sponsored;
const visual = rich && f.certified ? f.banner || f.photos[0] || '' : '';
const news = activeNews(f);
---
<li class:list={['frow', { rich, sponsored }]}>
  <a class:list={['row', { cert: f.certified }]} href={`/${f.slug}`} {...(sponsorId && { 'data-sponsor': sponsorId, 'data-ev': 'click_sponsored' })}>
    {visual ? <img class="visual" src={visual} alt="" loading="lazy" width="160" height="90" /> : <Avatar name={f.name} src={f.logo} size={rich ? 64 : 46} />}
    <span class="txt">
      <span class="nm"><Name name={f.name} certified={f.certified} />{sponsored ? <span class="tag spon">Sponsorisé</span> : f.premium && <span class="tag prem">Premium</span>}{news && <span class="tag offer">Offre</span>}</span>
      <span class="sub">{categoryName(f.category)} · {[f.street, f.city].filter(Boolean).join(', ')}</span>
      {rich && <span class="bio">{news ? f.news_title : f.short_desc}</span>}
    </span>
    <span class="meta">
      <OpenBadge hours={f.hours} />
      {f.certified && f.phone && <span class="tel">{phoneMasked(f.phone)}</span>}
    </span>
  </a>
</li>

<style>
  .frow + .frow { border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .row {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .9rem;
    padding: .75rem .6rem; border-radius: 12px; transition: background-color .12s;
  }
  .row:hover { background: var(--surface-2); }
  .txt { min-width: 0; display: flex; flex-direction: column; }
  .nm { font-weight: 650; }
  .sub { color: var(--muted); font-size: .86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .meta { display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; }
  .tel { color: var(--muted); font-size: .8rem; white-space: nowrap; }
  @media (max-width: 640px) { .meta { display: none; } .row { grid-template-columns: auto 1fr; } }
  .rich .row { padding: .9rem .7rem; }
  .rich { background: color-mix(in srgb, var(--cert) 5%, transparent); border-radius: 12px; }
  .sponsored { background: color-mix(in srgb, #f59e0b 10%, transparent); outline: 1px solid color-mix(in srgb, #f59e0b 35%, transparent); }
  .visual { width: 160px; height: 90px; object-fit: cover; border-radius: 10px; flex: none; }
  @media (max-width: 640px) { .visual { width: 96px; height: 64px; } }
  .bio { color: var(--text); font-size: .88rem; margin-top: .15rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tag { display: inline-block; margin-left: .4rem; padding: .05rem .45rem; border-radius: 999px; font-size: .68rem; font-weight: 700; vertical-align: middle; text-transform: uppercase; letter-spacing: .03em; }
  .prem { background: color-mix(in srgb, var(--cert) 16%, var(--surface)); color: var(--cert); }
  .spon { background: color-mix(in srgb, #f59e0b 22%, var(--surface)); color: #92400e; }
  .offer { background: color-mix(in srgb, #e11d48 14%, var(--surface)); color: #be123c; }
</style>
