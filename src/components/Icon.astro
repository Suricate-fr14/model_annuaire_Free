// Icônes : marques via simple-icons (CC0), pictogrammes d'interface dessinés ici.
import * as si from 'simple-icons';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 18, class: cls, label } = Astro.props;

const BRANDS: Record<string, any> = {
