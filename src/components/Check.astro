---
import { SITE } from '../config';
---
<span class="cert-check" title={SITE.pro.certifiedLabel}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="m5 12.5 4.5 4.5L19 7.5"></path>
  </svg>
  <span class="sr-only">, page certifiée</span>
</span>

<style>
  .cert-check {
    display: inline-grid; place-items: center; vertical-align: -0.12em;
    width: 1.05em; height: 1.05em; margin-left: .2em;
    border-radius: 50%; background: var(--cert); color: #fff;
  }
  .cert-check svg { width: 70%; height: 70%; }
</style>
