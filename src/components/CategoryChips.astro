---
// Grille des catégories d'un univers : une tuile par catégorie qui a des fiches, les vides regroupées sur une ligne.
import { categoryUrl, type Universe } from '../lib/taxonomy';

interface Props {
  universe: Universe;
  categories: { slug: string; name: string; count: number }[];
  current?: string;
}
const { universe, categories, current } = Astro.props;
const filled = categories.filter((c) => c.count > 0).sort((a, b) => b.count - a.count);
const empty = categories.filter((c) => c.count === 0);
---
<div class="cgrid-wrap" style={`--h:${universe.hue}`}>
  <ul class="cgrid">
    {filled.map((c) => (
      <li>
        <a href={categoryUrl(universe, c)} class="tile" aria-current={c.slug === current ? 'page' : undefined}>
          <span class="nm">{c.name}</span>
          <span class="ct">{c.count.toLocaleString('fr-FR')} {c.count > 1 ? 'fiches' : 'fiche'}</span>
          <span class="arr" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
  {empty.length > 0 && (
    <p class="empty">
      <span>Pas encore de fiche :</span> {empty.map((c) => c.name).join(' · ')}.
      <a href="/creer-ma-fiche">Référencer mon activité</a>
    </p>
  )}
</div>

<style>
  .cgrid { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1080px) { .cgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 780px) { .cgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .cgrid { grid-template-columns: 1fr; } }
  .tile {
    position: relative; display: flex; flex-direction: column; gap: .15rem; height: 100%;
    padding: .85rem 2.2rem .85rem 1rem; border: 1px solid var(--line); border-radius: 14px;
    background: var(--surface); border-left: 4px solid hsl(var(--h) 65% 58%);
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .tile:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: hsl(var(--h) 65% 58%); }
  .tile[aria-current] { background: hsl(var(--h) 70% 95%); border-color: hsl(var(--h) 65% 50%); }
  .nm { font-weight: 650; line-height: 1.3; }
  .ct { color: var(--muted); font-size: .82rem; }
  .arr { position: absolute; right: .9rem; top: 50%; translate: 0 -50%; color: hsl(var(--h) 55% 45%); font-weight: 700; transition: translate .15s; }
  .tile:hover .arr { translate: 3px -50%; }
  .empty { margin: .9rem 0 0; font-size: .85rem; color: var(--muted); }
  .empty span { font-weight: 600; }
  .empty a { color: var(--accent); font-weight: 600; margin-left: .3rem; }
</style>
