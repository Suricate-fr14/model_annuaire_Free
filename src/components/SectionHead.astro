---
interface Props { id: string; title: string; aside?: string }
const { id, title, aside } = Astro.props;
---
<div class="sh">
  <h2 id={id}>{title}</h2>
  {aside && <p>{aside}</p>}
</div>

<style>
  .sh { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  h2 { margin: 0; font-size: 1.3rem; letter-spacing: -0.01em; }
  p { margin: 0; color: var(--muted); font-size: .9rem; }
  p::first-letter { text-transform: uppercase; }
</style>
