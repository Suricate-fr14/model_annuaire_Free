---
import Avatar from './Avatar.astro';
import Name from './Name.astro';
import OpenBadge from './OpenBadge.astro';
import Icon from './Icon.astro';
import { SITE } from '../config';
import { categoryName } from '../lib/taxonomy';
import { activeNews, type Fiche } from '../lib/fiches';

interface Props { fiche: Fiche }
const { fiche: f } = Astro.props;
const visual = f.premium ? f.banner || f.photos[0] || '' : '';
const news = activeNews(f);
---
<a class:list={['card', { 'is-cert': f.certified, 'is-prem': f.premium }]} href={`/${f.slug}`}>
  {visual && <img class="visual" src={visual} alt="" loading="lazy" width="400" height="125" />}
  {(f.premium || news) && <span class="tags">{f.premium && <span class="tag prem">Premium</span>}{news && <span class="tag offer">Offre</span>}</span>}
  <span class="top">
    <Avatar name={f.name} src={f.logo} size={52} />
    <span class="cat">{categoryName(f.category)}</span>
  </span>
  <span class="card-name"><Name name={f.name} certified={f.certified} /></span>
  <span class="card-bio">{news ? f.news_title : f.short_desc}</span>
  <span class="card-foot">
    <span class="loc"><Icon name="pin" size={14} />{f.city || '—'}</span>
    <OpenBadge hours={f.hours} />
  </span>
</a>

<style>
  .card {
    display: flex; flex-direction: column; gap: .5rem; height: 100%;
    padding: 1.1rem; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow);
    transition: border-color .15s, transform .15s;
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); transform: translateY(-3px); }
  .card { position: relative; overflow: hidden; }
  .visual { margin: -1.1rem -1.1rem .2rem; width: calc(100% + 2.2rem); max-width: none; aspect-ratio: 16 / 5; object-fit: cover; }
  .is-prem { border-color: color-mix(in srgb, var(--cert) 55%, var(--line)) !important; box-shadow: 0 6px 22px color-mix(in srgb, var(--cert) 18%, transparent); }
  .tags { position: absolute; top: .6rem; right: .6rem; display: flex; gap: .3rem; }
  .is-prem:not(:has(.visual)) .tags { position: static; }
  .tag { padding: .1rem .5rem; border-radius: 999px; font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .prem { background: var(--surface); color: var(--cert); }
  .offer { background: #e11d48; color: #fff; }
  .card.is-cert { border-color: color-mix(in srgb, var(--cert) 35%, var(--line)); }
  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .cat {
    padding: .15rem .6rem; border-radius: 999px; background: var(--surface-2);
    color: var(--muted); font-size: .74rem; font-weight: 600;
    max-width: 65%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .card-name { font-weight: 700; font-size: 1.03rem; line-height: 1.3; margin-top: .25rem; }
  .card-bio {
    color: var(--muted); font-size: .88rem; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-foot {
    display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap;
    padding-top: .6rem; border-top: 1px dashed var(--line); font-size: .8rem;
  }
  .loc { display: inline-flex; align-items: center; gap: .3rem; color: var(--muted); font-weight: 500; min-width: 0; }
</style>
